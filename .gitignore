################################################################################
# Expensify.ai - Full Stack Monorepo .gitignore
# Backend: Spring Boot / Maven
# Frontend: Next.js / TypeScript / React
################################################################################

HELP.md
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
resource/
### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr
.idea_modules/
workspace.xml
projectCodeStyle.xml

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/
# Compiled class files
*.class

# Logs
*.log
logs/
*.pid
*.docs
docs/
# Spring Boot specific
*.jar
*.war

# ===============================
# Environment Configuration (DO NOT COMMIT SECRETS)
# ===============================
# Application-specific properties (create from -example templates)
application-local.yml
application-local.properties
application-dumps.properties
application-dumps.yml

# Secret env files - NEVER commit these
.env
.env.local
.env.*.local
.env.production.local

# Keep example files tracked for reference
!application-example.yml
!client/.env.example

# IDE-specific files
# IntelliJ
.idea/
out/

# Eclipse
.settings/
bin/

# VS Code

# OS generated files
.DS_Store
Thumbs.db

# Maven wrapper
.mvn/
!/.mvn/wrapper/maven-wrapper.jar
mvnw
mvnw.cmd

# Gradle
.gradle/

!gradle/wrapper/gradle-wrapper.jar
gradlew
gradlew.bat

# Test reports
test-output/
surefire-reports/
jacoco.exec

# Docker
docker-compose.override.yml
docker-compose.*.yml
Dockerfile.*

# Backup files
*.swp
*.bak
*~

# GitHub-specific
.github/

